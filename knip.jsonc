{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      // uv est installé hors npm ; le plugin anti-slop est une copie vendorisée.
      "ignoreBinaries": ["uv"],
      "ignore": ["tools/oxlint/anti-slop/**"],
    },
    "apps/api": {
      "ignoreBinaries": ["uv"],
    },
    "apps/web": {
      "entry": ["src/**/*.test.ts", "e2e/**/*.e2e.ts"],
      // Primitives shadcn : leurs exports inutilisés font partie du composant.
      "ignore": ["src/components/ui/**"],
    },
    "packages/api-client": {
      "ignore": ["src/generated/**"],
    },
  },
}
